{%- comment -%} Local copy of al_folio_core 1.0.15 _includes/header.liquid; changes: the bio page lives at /about/ (the site root is the interactive office), an Office menu item, and (v5) the .nav-mark indicator on the current item plus the .nav-progress hairline. {%- endcomment -%}
<header>
  {%- comment -%} v5 (plan.md change 7): a page reached by a same-origin navigation arrives through a cross-document view transition, and its title morphs (motion.css). Runs before the deferred motion.js, so the title's line-rise is dropped from MOTION_CONFIG and it is not animated twice. {%- endcomment -%}
  <script>
    (function () {
      try {
        var a = window.navigation && navigation.activation;
        if (!window.PageRevealEvent || !a || !a.from || a.navigationType === 'reload') return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('vt-in');
        var c = window.MOTION_CONFIG;
        if (c && c.auto) delete c.auto['.post-header .post-title'];
      } catch (e) {}
    })();
  </script>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/about/' or site.enable_navbar_social != true %}
        <a class="navbar-brand title font-weight-lighter{% if page.permalink == '/about/' %} brand-after-hero{% endif %}" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/about/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/about/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/about/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/about/' %}
                <span class="sr-only">(current)</span>
                <span class="nav-mark" aria-hidden="true"></span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                    {% if page.url contains parent_link %}
                      <span class="nav-mark" aria-hidden="true"></span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {%- comment -%} Local addition: the interactive office (static folder room/), last in the menu, only if it exists. {%- endcomment -%}
          {% include office_url.liquid %}
          {% if office_url %}
            <li class="nav-item nav-office">
              <a class="nav-link" href="{{ office_url }}">Office</a>
            </li>
          {% endif %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
    {%- comment -%} v5 (plan.md change 6): reading-progress hairline on the bar's bottom edge; chrome.css/chrome.js drive it. {%- endcomment -%}
    <span class="nav-progress" aria-hidden="true"></span>
  </nav>
  {%- comment -%} v5: al-folio's <progress id="progress"> bar is replaced by .nav-progress inside the bar (progress-bar.js no-ops without it). {%- endcomment -%}
</header>
