          </svg>
          <h2 class="finale-title" id="contact-title">Contact</h2>
          <p class="finale-email">
            <a href="mailto:{{ kit_email }}">{{ kit_email | replace: '@', '<wbr>@' }}</a>
          </p>
          <p class="contact-note">{{ site.contact_note }}</p>
        </div>
        <div class="finale-grid">
          <ul class="contact-links">
            {% if so.scholar_userid %}
              <li><a href="https://scholar.google.com/citations?user={{ so.scholar_userid }}" rel="external noopener">Google Scholar</a></li>
            {% endif %}
            {% if so.orcid_id %}
              <li><a href="https://orcid.org/{{ so.orcid_id }}" rel="external noopener">ORCID</a></li>
            {% endif %}
            {% if so.linkedin_username %}
              <li><a href="https://www.linkedin.com/in/{{ so.linkedin_username }}" rel="external noopener">LinkedIn</a></li>
            {% endif %}
          </ul>
          {% if page.profile.more_info %}
            <address class="contact-address">{{ page.profile.more_info }}</address>
          {% endif %}
          {%- comment -%}
            Contact kit (role S, v3): Save contact (vCard), Copy email (mailto when JS or the clipboard is unavailable),
            one-page profile PDF and a QR code to the site root. Files: assets/contact/vaishali-ingale.vcf, assets/img/site-qr.svg,
            assets/pdf/vaishali-ingale-profile.pdf (regenerate with /workspace/site_build/v3/tools/make_contact_kit.py and make_profile_pdf.py).
            Styles live in assets/custom/home.css.
          {%- endcomment -%}
          <section class="contact-kit" id="contact-kit" aria-labelledby="contact-kit-title">
            <div class="kit-main">
              <h3 class="kit-title" id="contact-kit-title">Invite or get in touch</h3>
              <div class="kit-actions">
                <a
                  class="kit-btn kit-btn-primary"
                  href="{{ '/assets/contact/vaishali-ingale.vcf' | relative_url }}"
                  download="vaishali-ingale.vcf"
                  type="text/vcard"
                  >Save contact</a
                >
                <a class="kit-btn" href="mailto:{{ kit_email }}" data-copy-email="{{ kit_email }}"
                  ><span data-copy-label>Email {{ kit_email }}</span></a
                >
                <a
                  class="kit-btn"
                  href="{{ '/assets/pdf/vaishali-ingale-profile.pdf' | relative_url }}"
                  download="vaishali-ingale-profile.pdf"
                  type="application/pdf"
                  >One-page profile (PDF)</a
                >
              </div>
              <p class="kit-status" data-copy-status role="status" aria-live="polite"></p>
            </div>
            <figure class="kit-qr">
              <img src="{{ '/assets/img/site-qr.svg' | relative_url }}" width="112" height="112" alt="QR code that opens this website" loading="lazy">
              <figcaption>Scan to open this site</figcaption>
            </figure>
          </section>
        </div>
        <script>
          (function () {
            var a = document.querySelector('[data-copy-email]');
            if (!a || !navigator.clipboard || !window.isSecureContext) return;
            var email = a.getAttribute('data-copy-email');
            var label = a.querySelector('[data-copy-label]');
            var status = document.querySelector('[data-copy-status]');
            var timer;
            label.textContent = 'Copy email';
            a.setAttribute('aria-label', 'Copy email address ' + email);
            a.addEventListener('click', function (e) {
              e.preventDefault();
              navigator.clipboard.writeText(email).then(
                function () {
                  label.textContent = 'Copied';
                  status.textContent = email + ' copied to the clipboard.';
                  clearTimeout(timer);
                  timer = setTimeout(function () {
                    label.textContent = 'Copy email';
                    status.textContent = '';
                  }, 2500);
                },
                function () {
                  window.location.href = 'mailto:' + email;
                }
              );
            });
          })();
        </script>
      </section>
    {% endif %}
  </article>
</div>
