---
layout: default
---
{%- comment -%}
  Local override of al_folio_core's about layout (see README_UPDATE.md).
  Professional hero: kicker, serif name, tagline, two calls to action, portrait.
  Content keys come from the front matter of _pages/about.md (kicker, name_prefix, hero_tagline, subtitle, profile).
  The primary button opens the interactive office at /room/ (a self-contained static folder, see README_UPDATE.md).
{%- endcomment -%}
<div class="post about-page">
  <section class="about-hero" data-hero>
    <div class="hero-art" data-parallax="80" aria-hidden="true"></div>
    <div class="hero-step hero-step-1">
      <div class="hero-text">
        {% if page.kicker %}<p class="hero-kicker" data-hero-item data-reveal="fade-up" data-start="load" data-delay="0.5">{{ page.kicker }}</p>{% endif %}
        <h1 class="post-title hero-title" data-hero-item data-reveal="lines" data-start="load" data-delay="0.15">
          {% if page.name_prefix %}<span class="name-prefix">{{ page.name_prefix }}</span>{% endif %}
          <span class="name-main">{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}</span>
        </h1>
        {% assign hero_tagline = page.hero_tagline | default: page.tagline %}
        {% if hero_tagline %}<p class="hero-tagline" data-hero-item data-reveal="lines" data-start="load" data-delay="0.35">{{ hero_tagline }}</p>{% endif %}
        {%- comment -%} The office button appears only when the office is deployed (root index.html or room/index.html, see office_url.liquid). {%- endcomment -%}
        {% include office_url.liquid %}
        <div class="hero-actions" data-hero-item data-reveal="fade-up" data-start="load" data-delay="0.75">
          {% if office_url %}<a class="hero-cta" href="{{ office_url }}">{{ page.hero_cta_text | default: 'Explore the office' }} <span aria-hidden="true">&rarr;</span></a>{% endif %}
          <a class="hero-link" href="{{ '/publications/' | relative_url }}">Publications <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
      {% if page.profile and page.profile.image %}
        <div class="hero-portrait" data-parallax="24">
          <div class="portrait-frame">
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class="img-fluid portrait-img" sizes="(min-width: 768px) 380px, 300px"
              alt="Prof. Vaishali S. Ingale" cache_bust=true
            %}
          </div>
        </div>
      {% endif %}
    </div>
  </section>

  {%- comment -%} Counters come from _data/stats.yml. "since" (YYYY-MM-DD) turns into whole years at build time; site.js recomputes it in the browser so it never goes stale. {%- endcomment -%}
  {% assign stats = site.data.stats %}
  {% if stats %}
    <section class="hero-stats stat-strip" aria-label="At a glance" data-reveal="fade-up">
      {% assign now_y = 'now' | date: '%Y' | plus: 0 %}
      {% assign now_md = 'now' | date: '%m%d' | plus: 0 %}
      {% for s in stats %}
        {% assign value = s.value %}
        {% if s.since %}
          {% assign since_str = s.since | date: '%Y-%m-%d' %}
          {% assign since_y = since_str | slice: 0, 4 | plus: 0 %}
          {% capture since_md %}{{ since_str | slice: 5, 2 }}{{ since_str | slice: 8, 2 }}{% endcapture %}
          {% assign since_md = since_md | plus: 0 %}
          {% assign value = now_y | minus: since_y %}
          {% if now_md < since_md %}{% assign value = value | minus: 1 %}{% endif %}
        {% endif %}
        {% assign stat_url = s.url %}
        {% if stat_url and stat_url != '' %}
          {% unless stat_url contains '://' %}{% assign stat_url = stat_url | relative_url %}{% endunless %}
        {% endif %}
        <div class="stat">
          {% if stat_url and stat_url != '' %}<a class="stat-link" href="{{ stat_url }}">{% endif %}
          {% if value >= 1000 %}
            {% assign th = value | divided_by: 1000 %}{% assign rest = value | modulo: 1000 | prepend: '00' | slice: -3, 3 %}
            {% capture shown %}{{ th }},{{ rest }}{% endcapture %}
          {% else %}
            {% assign shown = value %}
          {% endif %}
          <span class="stat-number"><span data-count="{{ value }}"{% if s.since %} data-since="{{ s.since | date: '%Y-%m-%d' }}"{% endif %}>{{ shown }}</span>{% if s.suffix and s.suffix != '' %}<span class="stat-suffix">{{ s.suffix }}</span>{% endif %}</span>
          <span class="stat-label">{{ s.label }}</span>
          {% if stat_url and stat_url != '' %}</a>{% endif %}
        </div>
      {% endfor %}
    </section>
  {% endif %}

  <article>
    <h2 class="sr-only">About</h2>
    <div class="clearfix about-bio">{{ content }}</div>

    {% if page.selected_papers %}
      <section class="about-section">
        <h2 class="section-heading" data-reveal="lines">
          <a href="{{ '/publications/' | relative_url }}">Selected publications</a>
        </h2>
        {% include selected_papers.liquid %}
        <p class="image-credit">Figure thumbnails: V. Ingale, R. Singh, P. Patwal, <a href="https://arxiv.org/abs/2105.09253">arXiv:2105.09253</a> (CC BY-NC-SA 4.0).</p>
      </section>
    {% endif %}

    {% if page.announcements and page.announcements.enabled %}
      <section class="about-section">
        <h2 class="section-heading" data-reveal="lines">
          <a href="{{ '/news/' | relative_url }}">Recent news</a>
        </h2>
        <div class="card-soft news-card">{% include news.liquid limit=true %}</div>
        <p class="news-all"><a href="{{ '/news/' | relative_url }}">All news &rarr;</a></p>
      </section>
    {% endif %}

    {% if page.social %}
      <div class="social">
        {% assign so = site.data.socials %}
        <ul class="contact-links">
          {% if so.email %}<li><a href="mailto:{{ so.email }}">{{ so.email }}</a></li>{% endif %}
          {% if so.scholar_userid %}<li><a href="https://scholar.google.com/citations?user={{ so.scholar_userid }}" rel="external noopener">Google Scholar</a></li>{% endif %}
          {% if so.orcid_id %}<li><a href="https://orcid.org/{{ so.orcid_id }}" rel="external noopener">ORCID</a></li>{% endif %}
          {% if so.linkedin_username %}<li><a href="https://www.linkedin.com/in/{{ so.linkedin_username }}" rel="external noopener">LinkedIn</a></li>{% endif %}
        </ul>
        <div class="contact-note">{{ site.contact_note }}</div>
        {% if page.profile.more_info %}<address class="contact-address">{{ page.profile.more_info }}</address>{% endif %}
        {%- comment -%}
          Contact kit (role S, v3): Save contact (vCard), Copy email (mailto when JS or the clipboard is unavailable),
          one-page profile PDF and a QR code to the site root. Files: assets/contact/vaishali-ingale.vcf, assets/img/site-qr.svg,
          assets/pdf/vaishali-ingale-profile.pdf (regenerate with /workspace/site_build/v3/tools/make_contact_kit.py and make_profile_pdf.py).
        {%- endcomment -%}
        {% assign kit_email = so.email | default: 'vingale@aitpune.edu.in' %}
        <section class="contact-kit card-soft" id="contact-kit" aria-labelledby="contact-kit-title">
          <div class="kit-main">
            <h2 class="kit-title" id="contact-kit-title">Invite or get in touch</h2>
            <div class="kit-actions">
              <a class="kit-btn kit-btn-primary" href="{{ '/assets/contact/vaishali-ingale.vcf' | relative_url }}" download="vaishali-ingale.vcf" type="text/vcard">Save contact</a>
              <a class="kit-btn" href="mailto:{{ kit_email }}" data-copy-email="{{ kit_email }}"><span data-copy-label>Email {{ kit_email }}</span></a>
              <a class="kit-btn" href="{{ '/assets/pdf/vaishali-ingale-profile.pdf' | relative_url }}" download="vaishali-ingale-profile.pdf" type="application/pdf">One-page profile (PDF)</a>
            </div>
            <p class="kit-status" data-copy-status role="status" aria-live="polite"></p>
          </div>
          <figure class="kit-qr">
            <img src="{{ '/assets/img/site-qr.svg' | relative_url }}" width="112" height="112" alt="QR code that opens this website" loading="lazy">
            <figcaption>Scan to open this site</figcaption>
          </figure>
        </section>
        <style>
          .contact-kit { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem 2rem; margin: 2rem 0 0; }
          .contact-kit .kit-main { flex: 1 1 320px; min-width: 0; }
          .contact-kit .kit-title { font-family: "Fraunces", Georgia, serif; font-size: var(--fs-h4, 1.5rem); font-weight: 400; line-height: 1.25; margin: 0 0 1rem; color: #1f1712; }
          .contact-kit .kit-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
          #contact-kit a.kit-btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0.6rem 1.25rem; border-radius: 999px; border: 1px solid rgba(160, 74, 13, 0.45); background: transparent; color: #7a3609 !important; font-family: "Inter", system-ui, sans-serif; font-size: 0.9375rem; font-weight: 500; line-height: 1.3; text-decoration: none !important; transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease; overflow-wrap: anywhere; }
          #contact-kit a.kit-btn span { color: inherit; }
          #contact-kit a.kit-btn:hover { background: rgba(160, 74, 13, 0.08); border-color: #a04a0d; }
          #contact-kit a.kit-btn.kit-btn-primary { background: #a04a0d; border-color: #a04a0d; color: #fbf4ec !important; }
          #contact-kit a.kit-btn.kit-btn-primary:hover, #contact-kit a.kit-btn.kit-btn-primary:focus-visible { background: #7a3609; border-color: #7a3609; }
          .contact-kit .kit-status { min-height: 1.4em; margin: 0.6rem 0 0; font-size: 0.875rem; color: #5e4b3f; }
          .contact-kit .kit-qr { flex: 0 0 auto; margin: 0; text-align: center; }
          .contact-kit .kit-qr img { display: block; width: 112px; height: 112px; margin: 0 auto; background: #fffaf4; border-radius: 8px; padding: 4px; }
          .contact-kit .kit-qr figcaption { margin-top: 0.4rem; font-size: 0.8125rem; color: #5e4b3f; }
          @media (max-width: 575.98px) { .contact-kit .kit-actions { flex-direction: column; align-items: stretch; } #contact-kit a.kit-btn { justify-content: center; } .contact-kit .kit-qr { display: none; } }
        </style>
        <script>
          (function () {
            var a = document.querySelector('[data-copy-email]');
            if (!a || !navigator.clipboard || !window.isSecureContext) return;
            var email = a.getAttribute('data-copy-email');
            var label = a.querySelector('[data-copy-label]');
            var status = document.querySelector('[data-copy-status]');
            var timer;
            label.textContent = 'Copy email';
            a.setAttribute('aria-label', 'Copy email address ' + email);
            a.addEventListener('click', function (e) {
              e.preventDefault();
              navigator.clipboard.writeText(email).then(function () {
                label.textContent = 'Copied';
                status.textContent = email + ' copied to the clipboard.';
                clearTimeout(timer);
                timer = setTimeout(function () { label.textContent = 'Copy email'; status.textContent = ''; }, 2500);
              }, function () { window.location.href = 'mailto:' + email; });
            });
          })();
        </script>
      </div>
    {% endif %}
  </article>
</div>
