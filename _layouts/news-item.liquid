---
layout: default
---
{%- comment -%} One news item. Replaces al-folio's blog-post layout (no "Created on" line, no tags). {%- endcomment -%}
<div class="post news-item">
  <header class="post-header">
    <p class="card-kicker"><time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%-d %B %Y' }}</time></p>
    <h1 class="post-title">{{ page.title }}</h1>
  </header>
  <article class="post-content">{{ content }}</article>
  <p class="news-back"><a href="{{ '/news/' | relative_url }}">&larr; All news</a></p>
</div>
